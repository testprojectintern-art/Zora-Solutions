{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/:path*",
          "destination": "/index.html"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "server" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/uploads/:path*",
      "destination": { "service": "server" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "client" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
